rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requester is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Helper function to verify current authenticated user
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Videos collection
    match /videos/{videoId} {
      // Anyone can read published videos; admins can read all
      allow read: if resource.data.published == true || isAdmin();
      
      // Only admins can create, update metadata, or delete videos
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
        // Allow public/users to increment views and shares counters
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'shares']));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Advertisements & Settings configuration
    match /settings/{settingId} {
      allow read: if true; // Public can read ad config for redirection
      allow write: if isAdmin(); // Only admins can update ad destination and AdMob IDs
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
